{
  "timeZone": "Africa/Lagos",
  "runtimeVersion": "V8",
  "exceptionLogging": "NONE",
  "oauthScopes": [
    "https://www.googleapis.com/auth/drive.file",
    "https://www.googleapis.com/auth/script.external_request",
    "https://www.googleapis.com/auth/gmail.addons.execute",
    "https://www.googleapis.com/auth/gmail.addons.current.action.compose"
  ],
  "urlFetchWhitelist": [
    "https://docs.googleapis.com/",
    "https://sheets.googleapis.com/",
    "https://slides.googleapis.com/"
  ],
  "addOns": {
    "common": {
      "name": "Beautiful MD",
      "logoUrl": "https://www.gstatic.com/images/branding/product/1x/docs_48dp.png",
      "layoutProperties": { "primaryColor": "#a13a22", "secondaryColor": "#342b25" },
      "openLinkUrlPrefixes": ["https://docs.google.com/"],
      "homepageTrigger": { "runFunction": "onHomepage" }
    },
    "docs": { "onFileScopeGrantedTrigger": { "runFunction": "onHomepage" } },
    "sheets": { "onFileScopeGrantedTrigger": { "runFunction": "onHomepage" } },
    "slides": { "onFileScopeGrantedTrigger": { "runFunction": "onHomepage" } },
    "gmail": {
      "homepageTrigger": { "runFunction": "onHomepage" },
      "composeTrigger": {
        "draftAccess": "NONE",
        "selectActions": [{ "text": "Format Markdown", "runFunction": "onGmailCompose" }]
      }
    }
  }
}
